# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform variable files may contain secrets
*.tfvars
*.tfvars.json

# Terraform plan files
*.tfplan

# Crash logs
crash.log
crash.*.log

# Local Terraform CLI configuration
.terraformrc
terraform.rc

# Environment / secret files
.env
.env.*

# Private keys
*.pem
*.key